int iPipBoyType
int iPOV
ref rPipboy
ref rMapMarker
ref rIdleAnim
string_var sAnimPath

begin function {}

	; ----------------------------------------------------------------------------
	;  Attach Node Check
	; ----------------------------------------------------------------------------
	if eval !ModelHasBlock Player "B42AttachPointL"
		InsertNode Player 3 "Bip01 L Hand|B42AttachPointL"
		Player.RefreshAnimData
	endif

	; Validate clone
	if eval IsFormValid (rIdleAnim = Goo1.AuxVarGetRef "*ALD_Anim") == 0 || GetType rIdleAnim != 72 || GetEditorID rIdleAnim != "ALDAnim"
		rIdleAnim = TempCloneForm LooseTalkLHCasualH060
		SetEditorID rIdleAnim "ALDAnim"
		Goo1.AuxVarSetRef "*ALD_Anim" rIdleAnim
	endif

	; Map marker specific anims
	rMapMarker = Goo1.AuxVarGetRef "*ALD_MarkerRef"
	sAnimPath = rMapMarker.GetMapMarkerName
	if eval FileExists ("meshes\B42Interact\ALD\EDID\" + (sAnimPath)) 1
		sAnimPath = "B42Interact\ALD\EDID\" + (sAnimPath)
	else
		sAnimPath = "B42Interact\ALD\Anim"
	endif

	if eval IsPC1stPerson
		iPOV = 2
		sAnimPath += "\1st\"
	else
		iPOV = 1
		sAnimPath += "\3rd\"
	endif

	; Pip-Boy specific anims
	rPipboy = Player.GetEquippedObject 6
	if eval (GetBipedModelPath 0 rPipboy) == "PIP-Boy2000MC\pipboyarm.nif" && FileExists ("meshes\" + (sAnimPath) + "PipBoy_2000.kf")
		sAnimPath += "PipBoy_2000.kf"
	;elseif ModelHasBlock rPipboy "RadDummy01" && ModelHasBlock rPipboy "GlassLight" == 0
	;	sINIPath = "2000MkVI"
	;elseif ModelHasBlock rPipboy "PipBoyArm:0:111"
	;	sINIPath = "3000Remastered"
	;elseif eval Goo1.AuxVarGetFlt "*PipMap_Support" 0
	;	sINIPath = "2500A"
	else
		sAnimPath += "PipBoy_3000.kf"
	endif

	; Set the name first so it shows even if the marker type is unavailable
	SetUIStringAlt	"HUDMainMenu\LocationDiscovery\MapMarker\_Location" (rMapMarker.GetMapMarkerName)

	; Update map
	rMapMarker.GetWorldMapPosMults (float fPosX) (float fPosY)
	SetUIFloatAlt "HUDMainMenu\LocationDiscovery\_PlrX" fPosX
	SetUIFloatAlt "HUDMainMenu\LocationDiscovery\_PlrY" fPosY
	SetUIFloatAlt "HUDMainMenu\LocationDiscovery\MapMarker\_Type" 0
	SetUIFloatGradual "HUDMainMenu\LocationDiscovery\_Animation" 0

	; Update model
	ToggleNthPipboyLight 0 0
	ToggleNthPipboyLight 1 0
	ToggleNthPipboyLight 2 0
	if eval ModelHasBlock Player "RadNeedle"
		Player.GetNifRotAlt "RadNeedle" (float fTemp1) (float fTemp2) (float fTemp3) 2 2
		fTemp3 = (((Player.GetAV RadiationRads) - 500) / 500) * 90
		Player.SetNifRot "RadNeedle" (fTemp1) (fTemp2) (fTemp3) 2 2
	endif

	; Open Fallout: The New West Pip-Boy screen
	if eval ModelHasBlock Player "screenlid"
		Player.SetNifRot "screenlid" -80 0 0 2 2
	endif

	Player.SetNifBlockFlag "pipboyscreen:0" 0 1
	Player.SetMatrPropVal "PipboyLightEffect:0" 7 0
	Player.SetMatrPropVal "PipboyLightEffect:0_TNW" 7 0
	Player.SetMatrPropVal "PipboyLightEffect:1_N" 7 0
	Player.SetMatrPropVal "PipboyLightEffect:1_TNW" 7 0
	Player.SetMatrPropVal "pipboyscreen:0" 3 1
	Player.SetMatrPropVal "pipboyscreen:0" 4 1
	Player.SetMatrPropVal "pipboyscreen:0" 5 1
	Player.SetMatrPropVal "pipboyscreen:0" 8 1.5

	; Reset block for chameleon effect
	if eval Player.GetAV Chameleon > 0
		Player.SetMatrPropVal "pipboyscreen:0" 7 0.99
	else
		Player.SetMatrPropVal "pipboyscreen:0" 7 1
	endif

	; "Pip-Boy Screen Always On" compatibility
	Player.AuxVarSetFlt "*_PBSAODisable" 1

	; Disable controls
	if eval GSIV 0 > 0
		SetSmoothIronsightsValue 0 0
	endif
	SetUIFloatAlt "HUDMainMenu\JDC\_visible_stent" 0
	SetUIFloatAlt "HUDMainMenu\ReticleCenter\reticle_center\alpha" 0

	SetIdleAnimPath rIdleAnim (sAnimPath)
	Player.ForcePlayIdle rIdleAnim iPOV
	CallAfterFrames 5 ({} => Player.ProjectUITile "HUDMainMenu\LocationDiscovery" "pipboyscreen:0" -15000 -15000 1024 768)

	; ----------------------------------------------------------------------------
	;  Animation Cleanup
	; ----------------------------------------------------------------------------
	CallAfter 2 (begin Function {}
		CallWhen (begin Function {}
			SetUIFloatAlt "HUDMainMenu\JDC\_visible_stent" 1
			SetUIFloatAlt "HUDMainMenu\ReticleCenter\reticle_center\alpha" 255
		end) ({} => Player.IsIdlePlayingEx (Goo1.AuxVarGetRef "*ALD_Anim") == 0)
	end)

	sv_destruct sAnimPath

end
