int iPipBoyType
int iPOV
ref rPipboy
ref rMapMarker
ref rIdleAnim
string_var sAnimPath

begin function {}

	; ----------------------------------------------------------------------------
	;  Attach Node Check
	; ----------------------------------------------------------------------------
	if eval !ModelHasBlock Player "B42AttachPointL"
		InsertNode Player 3 "Bip01 L Hand|B42AttachPointL"
		Player.RefreshAnimData
	endif

	; Validate clone
	if eval IsFormValid (rIdleAnim = Goo1.AuxVarGetRef "*ALD_Anim") == 0 || GetType rIdleAnim != 72 || GetEditorID rIdleAnim != "ALDAnim"
		rIdleAnim = TempCloneForm LooseTalkLHCasualH060
		SetEditorID rIdleAnim "ALDAnim"
		Goo1.AuxVarSetRef "*ALD_Anim" rIdleAnim
	endif

	; Map marker specific anims
	rMapMarker = Goo1.AuxVarGetRef "*ALD_MarkerRef"
	sAnimPath = rMapMarker.GetMapMarkerName
	if eval FileExists ("meshes\B42Interact\ALD\EDID\" + (sAnimPath)) 1
		sAnimPath = "B42Interact\ALD\EDID\" + (sAnimPath)
	else
		sAnimPath = "B42Interact\ALD\Anim"
	endif

	if eval IsPC1stPerson
		iPOV = 2
		sAnimPath += "\1st\"
	else
		iPOV = 1
		sAnimPath += "\3rd\"
	endif

	; Pip-Boy specific anims
	rPipboy = Player.GetEquippedObject 6
	if eval (GetBipedModelPath 0 rPipboy) == "PIP-Boy2000MC\pipboyarm.nif" && FileExists ("meshes\" + (sAnimPath) + "PipBoy_2000.kf")
		sAnimPath += "PipBoy_2000.kf"
	;elseif ModelHasBlock rPipboy "RadDummy01" && ModelHasBlock rPipboy "GlassLight" == 0
	;	sINIPath = "2000MkVI"
	;elseif ModelHasBlock rPipboy "PipBoyArm:0:111"
	;	sINIPath = "3000Remastered"
	;elseif eval Goo1.AuxVarGetFlt "*PipMap_Support" 0
	;	sINIPath = "2500A"
	else
		sAnimPath += "PipBoy_3000.kf"
	endif

	Call (CompileScript "ALD\ALD_Location_Handler.gek") rMapMarker

	; Disable controls
	if eval GSIV 0 > 0
		SetSmoothIronsightsValue 0 0
	endif
	SetUIFloatAlt "HUDMainMenu\JDC\_visible_stent" 0
	SetUIFloatAlt "HUDMainMenu\ReticleCenter\reticle_center\alpha" 0

	SetIdleAnimPath rIdleAnim (sAnimPath)
	Player.ForcePlayIdle rIdleAnim iPOV
	CallAfterFrames 5 ({} => Player.ProjectUITile "HUDMainMenu\LocationDiscovery" "pipboyscreen:0" -15000 -15000 1024 768)

	; ----------------------------------------------------------------------------
	;  Animation Cleanup
	; ----------------------------------------------------------------------------
	CallAfter 2 (begin Function {}
		CallWhen (begin Function {}
			SetUIFloatAlt "HUDMainMenu\JDC\_visible_stent" 1
			SetUIFloatAlt "HUDMainMenu\ReticleCenter\reticle_center\alpha" 255
		end) ({} => Player.IsIdlePlayingEx (Goo1.AuxVarGetRef "*ALD_Anim") == 0)
	end)

	sv_destruct sAnimPath

end
