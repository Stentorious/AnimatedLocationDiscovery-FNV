ref rMapMarker

float fPosX
float fPosY

begin Function {rMapMarker}
	;print "location handler running"

	; Validate marker
	if eval IsReference rMapMarker == 0
		return
	endif

	; Set the name first so it shows even if the marker type is unavailable
	SetUIStringAlt	"HUDMainMenu\LocationDiscovery\MapMarker\_Location" (rMapMarker.GetMapMarkerName)

	if eval rMapMarker.GetMapMarkerType == 0
		return
	endif

	; Update map
	rMapMarker.GetWorldMapPosMults (fPosX) (fPosY)
	SetUIFloatAlt "HUDMainMenu\LocationDiscovery\_PlrX" fPosX
	SetUIFloatAlt "HUDMainMenu\LocationDiscovery\_PlrY" fPosY
	SetUIFloatAlt "HUDMainMenu\LocationDiscovery\MapMarker\_Type" 0
	SetUIFloatGradual "HUDMainMenu\LocationDiscovery\_Animation" 0

	; Update model
	ToggleNthPipboyLight 0 0
	ToggleNthPipboyLight 1 0
	ToggleNthPipboyLight 2 0
	if eval ModelHasBlock Player "RadNeedle"
		Player.GetNifRotAlt "RadNeedle" (float fTemp1) (float fTemp2) (float fTemp3) 2 2
		fTemp3 = (((Player.GetAV RadiationRads) - 500) / 500) * 90
		Player.SetNifRot "RadNeedle" (fTemp1) (fTemp2) (fTemp3) 2 2
	endif
	Player.SetNifBlockFlag "pipboyscreen:0" 0 1
	Player.SetMatrPropVal "PipboyLightEffect:0" 7 0
	Player.SetMatrPropVal "PipboyLightEffect:0_TNW" 7 0
	Player.SetMatrPropVal "PipboyLightEffect:1_N" 7 0
	Player.SetMatrPropVal "PipboyLightEffect:1_TNW" 7 0
	Player.SetMatrPropVal "pipboyscreen:0" 3 1
	Player.SetMatrPropVal "pipboyscreen:0" 4 1
	Player.SetMatrPropVal "pipboyscreen:0" 5 1
	Player.SetMatrPropVal "pipboyscreen:0" 8 1.5

	; Reset block for chameleon effect
	if eval Player.GetAV Chameleon > 0
		Player.SetMatrPropVal "pipboyscreen:0" 7 0.99
	else
		Player.SetMatrPropVal "pipboyscreen:0" 7 1
	endif

	; "Pip-Boy Screen Always On" compatibility
	Player.AuxVarSetFlt "*_PBSAODisable" 1

end
